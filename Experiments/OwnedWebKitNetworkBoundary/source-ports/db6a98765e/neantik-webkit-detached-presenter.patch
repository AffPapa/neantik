+#if PLATFORM(MAC)
+void WebPage::invalidateNeAntikDetachedEditor()
+{
+    m_neAntikDetachedFocusToken = { };
+    m_neAntikDetachedEditingRoot = nullptr;
+}
+
+static bool detachedSelectionIsSecure(LocalFrame& frame, Element& focused)
+{
+    RefPtr input = dynamicDowncast<HTMLInputElement>(focused);
+    return (input && input->isPasswordField()) || frame.selection().selection().isInPasswordField();
+}
+
+void WebPage::neAntikDetachedEditorSnapshot(CompletionHandler<void(const String&, bool, const EditingRange&, const EditingRange&, const IntRect&)>&& reply)
+{
+    auto& focus = corePage()->focusController();
+    RefPtr frame = focus.localFocusedFrame();
+    RefPtr document = frame ? frame->document() : nullptr;
+    RefPtr element = document ? document->focusedElement() : nullptr;
+    RefPtr view = frame ? frame->view() : nullptr;
+    if (!focus.isFocused() || !element || !element->isConnected() || !view)
+        return reply({ }, false, { }, { }, { });
+
+    const auto& selection = frame->selection().selection();
+    RefPtr root = selection.rootEditableElement();
+    if (!root || (root.get() != element.get() && !root->isShadowIncludingDescendantOf(*element)))
+        return reply({ }, false, { }, { }, { });
+
+    if (m_neAntikDetachedFocusToken.isEmpty() || m_neAntikDetachedEditingRoot.get() != root.get()) {
+        m_neAntikDetachedFocusToken = WTF::UUID::createVersion4().toString();
+        m_neAntikDetachedEditingRoot = WeakPtr { *root };
+    }
+    if (detachedSelectionIsSecure(*frame, *element))
+        return reply(m_neAntikDetachedFocusToken, true, { }, { }, { });
+
+    const auto selected = EditingRange::fromRange(*frame, selection.toNormalizedRange());
+    const auto marked = EditingRange::fromRange(*frame, protect(frame->editor())->compositionRange());
+    auto caret = view->contentsToMainFrameView(frame->selection().absoluteCaretBounds());
+    reply(m_neAntikDetachedFocusToken, false, selected, marked, caret);
+}
+
+void WebPage::neAntikDetachedEditorCommand(const String& token, bool secure, const String& action, const String& text, const EditingRange& selected, const EditingRange& replacement, const EditingRange& expectedSelection)
+{
+    if (token.isEmpty() || token != m_neAntikDetachedFocusToken || text.length() > 4096)
+        return;
+    auto& focus = corePage()->focusController();
+    RefPtr frame = focus.localFocusedFrame();
+    RefPtr document = frame ? frame->document() : nullptr;
+    RefPtr element = document ? document->focusedElement() : nullptr;
+    if (!focus.isFocused() || !element || !element->isConnected() || secure != detachedSelectionIsSecure(*frame, *element))
+        return;
+    const auto& selection = frame->selection().selection();
+    RefPtr root = selection.rootEditableElement();
+    if (!root || root.get() != m_neAntikDetachedEditingRoot.get()
+        || (root.get() != element.get() && !root->isShadowIncludingDescendantOf(*element)))
+        return;
+
+    if (replacement.location != notFound) {
+        auto currentSelection = EditingRange::fromRange(*frame, selection.toNormalizedRange());
+        if (secure || !replacement.isValid() || currentSelection.location != expectedSelection.location
+            || currentSelection.length != expectedSelection.length)
+            return;
+    }
+    if (action == "insert"_s)
+        return insertTextAsync(text, replacement, { });
+    if (action == "mark"_s && !secure && selected.isValid() && selected.location <= text.length()
+        && selected.length <= text.length() - selected.location)
+        return setCompositionAsync(text, { }, { }, { }, selected, replacement);
+    if (action == "unmark"_s && !secure)
+        return confirmCompositionAsync();
+    if (action == "cancel"_s && !secure)
+        return protect(frame->editor())->cancelComposition();
+
+    // Only fixed native selectors are converted to editing commands by the UIProcess.
+    if (action == "DeleteBackward"_s || action == "DeleteForward"_s || action == "MoveLeft"_s || action == "MoveRight"_s
+        || action == "MoveUp"_s || action == "MoveDown"_s || action == "MoveWordLeft"_s || action == "MoveWordRight"_s
+        || action == "MoveLeftAndModifySelection"_s || action == "MoveRightAndModifySelection"_s
+        || action == "MoveToBeginningOfLine"_s || action == "MoveToEndOfLine"_s || action == "SelectAll"_s

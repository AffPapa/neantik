diff --git a/Source/WebKit/UIProcess/mac/DetachedPresenterActivity.h b/Source/WebKit/UIProcess/mac/DetachedPresenterActivity.h
new file mode 100644
--- /dev/null
+++ b/Source/WebKit/UIProcess/mac/DetachedPresenterActivity.h
@@ -0,0 +1,38 @@
+#pragma once
+
+#import <AppKit/NSView.h>
+#import <Foundation/Foundation.h>
+#import <objc/runtime.h>
+#include <optional>
+
+namespace WebKit {
+
+struct DetachedPresenterActivity {
+    bool visible { false };
+    bool active { false };
+    bool focused { false };
+    bool operator==(const DetachedPresenterActivity&) const = default;
+};
+
+inline const void *detachedPresenterActivityKey()
+{
+    // Objective-C selectors are interned across translation units.
+    return sel_registerName("_neantikDetachedPresenterActivity");
+}
+
+inline std::optional<DetachedPresenterActivity> detachedPresenterActivity(NSView *view)
+{
+    NSNumber *value = objc_getAssociatedObject(view, detachedPresenterActivityKey());
+    if (!value || view.window)
+        return std::nullopt;
+    auto bits = value.unsignedCharValue;
+    return DetachedPresenterActivity { !!(bits & 1), !!(bits & 2), !!(bits & 4) };
+}
+
+inline void setDetachedPresenterActivity(NSView *view, DetachedPresenterActivity activity)
+{
+    unsigned bits = (activity.visible ? 1 : 0) | (activity.active ? 2 : 0) | (activity.focused ? 4 : 0);
+    objc_setAssociatedObject(view, detachedPresenterActivityKey(), @(bits), OBJC_ASSOCIATION_RETAIN_NONATOMIC);
+}
+
+} // namespace WebKit

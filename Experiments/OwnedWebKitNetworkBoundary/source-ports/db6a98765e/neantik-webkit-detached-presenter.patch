+#if defined(NEANTIK_DETACHED_PRESENTER)
+@interface WKWebView (NeAntikDetachedPresenter)
+- (BOOL)_neantikApplyDetachedPresenterInput:(NSDictionary *)input;
+- (void)_neantikReadDetachedEditorState:(void (^)(NSDictionary *))reply;
+@end
+
+@implementation WKWebView (NeAntikDetachedPresenter)
+
+- (void)_neantikReadDetachedEditorState:(void (^)(NSDictionary *))reply
+{
+    if (!reply)
+        return;
+    const auto activity = WebKit::detachedPresenterActivity(self);
+    if (!activity || !activity->focused || !_page->hasRunningProcess())
+        return reply(nil);
+
+    _page->neAntikDetachedEditorSnapshot([weakSelf = WeakObjCPtr<WKWebView>(self), reply = makeBlockPtr(reply)]
+        (const String& token, bool secure, const WebKit::EditingRange& selected,
+            const WebKit::EditingRange& marked, const WebCore::IntRect& caret) {
+        RetainPtr view = weakSelf.get();
+        auto currentActivity = view ? WebKit::detachedPresenterActivity(view.get()) : std::nullopt;
+        if (!currentActivity || !currentActivity->focused || token.isEmpty())
+            return reply(nil);
+
+        auto editingToken = token.createNSString();
+        if (secure)
+            return reply(@{ @"token": editingToken.get(), @"secure": @YES });
+
+        return reply(@{ @"token": editingToken.get(), @"secure": @NO,
+            @"selected": [NSValue valueWithRange:selected],
+            @"marked": [NSValue valueWithRange:marked],
+            @"caret": [NSValue valueWithRect:NSMakeRect(caret.x(), caret.y(), caret.width(), caret.height())] });
+    });
+}
+
+- (BOOL)_neantikApplyDetachedPresenterInput:(NSDictionary *)input
+{
+    if (self.window || !_page->hasRunningProcess())
+        return NO;
+    NSString *action = input[@"action"];
+    if ([action isEqualToString:@"activity"]) {
+        bool visible = [input[@"visible"] boolValue];
+        bool active = visible && [input[@"active"] boolValue];
+        bool focused = active && [input[@"focused"] boolValue];
+        WebKit::DetachedPresenterActivity activity { visible, active, focused };
+        auto previous = WebKit::detachedPresenterActivity(self);
+        if (previous == activity)
+            return YES;
+        if (!previous)
+            _page->setShouldSkipWaitingForPaintAfterNextViewDidMoveToWindow(true);
+        WebKit::setDetachedPresenterActivity(self, activity);
+        using State = WebCore::ActivityState;
+        _page->activityStateDidChange({ State::WindowIsActive, State::IsFocused, State::IsVisible,
+            State::IsVisibleOrOccluded, State::IsInWindow, State::IsVisuallyIdle },
+            WebKit::WebPageProxy::ActivityStateChangeDispatchMode::Immediate);
+        return YES;
+    }
+    auto activity = WebKit::detachedPresenterActivity(self);
+    if (!activity || !activity->active)
+        return NO;
+    if ([action isEqualToString:@"click"] || [action isEqualToString:@"scroll"]) {
+        NSPoint position = [input[@"point"] pointValue];
+        if (!NSPointInRect(position, self.bounds))
+            return NO;
+        if ([action isEqualToString:@"click"]) {
+            if (!activity->focused)
+                return NO;
+            NSPoint globalPosition = [input[@"screenPoint"] pointValue];
+            if (!std::isfinite(globalPosition.x) || !std::isfinite(globalPosition.y))
+                return NO;
+            for (auto type : { WebKit::WebEventType::MouseDown, WebKit::WebEventType::MouseUp }) {
+                WebKit::WebMouseEventData data;
+                data.button = WebKit::WebMouseEventButton::Left;
+                data.buttons = type == WebKit::WebEventType::MouseDown ? 1 : 0;
+                data.position = { position.x, position.y };
+                data.globalPosition = { globalPosition.x, globalPosition.y };
+                data.clickCount = 1;
+                data.canInitiateDrag = WebCore::PlatformMouseEvent::CanInitiateDrag::No;
+                _page->handleMouseEvent(WebKit::NativeWebMouseEvent::create(
+                    { { type, { }, MonotonicTime::now() }, WTF::move(data) }));
+            }
+            return YES;
+        }
+        float deltaX = [input[@"deltaX"] floatValue];
+        float deltaY = [input[@"deltaY"] floatValue];
+        if (!std::isfinite(deltaX) || !std::isfinite(deltaY))
+            return NO;
+        auto timestamp = MonotonicTime::now();
+        auto event = WebKit::WebWheelEvent::create({ WebKit::WebEventType::Wheel, { }, timestamp }, {
+            .position = { static_cast<int>(position.x), static_cast<int>(position.y) },
+            .delta = { deltaX, deltaY },
+            .granularity = WebKit::WebWheelEvent::Granularity::ScrollByPixelWheelEvent,
+            .hasPreciseScrollingDeltas = true,
+            .scrollCount = 1,
+            .unacceleratedScrollingDelta = { deltaX, deltaY },
+            .ioHIDEventTimestamp = timestamp,
+        });
+        _page->handleNativeWheelEvent(WebKit::NativeWebWheelEvent::create(event));
+        return YES;
+    }
+    if (!activity->focused)
+        return NO;
+    NSString *token = input[@"token"];
+    NSString *text = input[@"text"] ?: @"";
+    if (![token isKindOfClass:NSString.class] || token.length != 36
+        || ![text isKindOfClass:NSString.class] || text.length > 4096)
+        return NO;
+    auto readRange = [&](NSString *key) -> WebKit::EditingRange {
+        id range = input[key];
+        return [range isKindOfClass:NSValue.class] ? WebKit::EditingRange { [range rangeValue] } : WebKit::EditingRange { };
+    };
+    _page->neAntikDetachedEditorCommand(token, [input[@"secure"] boolValue], action, text,
+        readRange(@"selection"), readRange(@"replacement"), readRange(@"expectedSelection"));
+    return YES;
+}
+
+@end
+#endif
+

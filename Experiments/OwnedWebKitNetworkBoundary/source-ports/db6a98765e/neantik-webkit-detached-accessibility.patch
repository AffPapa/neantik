 #if PLATFORM(MAC)
+static String detachedAccessibilityRole(const AXCoreObject& node)
+{
+    switch (node.role()) {
+    case AccessibilityRole::WebArea: return "AXWebArea"_s;
+    case AccessibilityRole::Heading: return "AXHeading"_s;
+    case AccessibilityRole::StaticText: return "AXStaticText"_s;
+    case AccessibilityRole::Button:
+    case AccessibilityRole::ToggleButton: return "AXButton"_s;
+    case AccessibilityRole::Link: return "AXLink"_s;
+    case AccessibilityRole::Checkbox: return "AXCheckBox"_s;
+    case AccessibilityRole::RadioButton: return "AXRadioButton"_s;
+    case AccessibilityRole::Image: return "AXImage"_s;
+    case AccessibilityRole::TextArea: return "AXTextArea"_s;
+    case AccessibilityRole::TextField: return "AXTextField"_s;
+    default: return "AXGroup"_s;
+    }
+}
+
+static bool detachedAccessibilityCanPress(const AXCoreObject& node)
+{
+    switch (node.role()) {
+    case AccessibilityRole::Button:
+    case AccessibilityRole::ToggleButton:
+    case AccessibilityRole::Link:
+    case AccessibilityRole::Checkbox:
+    case AccessibilityRole::RadioButton:
+        return node.isEnabled();
+    default:
+        return false;
+    }
+}
+
+static String detachedAccessibilityLabel(const AXCoreObject& node)
+{
+    RefPtr source = node.node();
+    if (!source || source->isInUserAgentShadowTree())
+        return { };
+
+    // Accessible name computation can incorporate live values from other
+    // controls through references. Only read literal names and static text.
+    constexpr unsigned labelLimit = 48;
+    if (RefPtr element = dynamicDowncast<Element>(source)) {
+        for (const auto* attribute : { &HTMLNames::aria_labelAttr.get(), &HTMLNames::altAttr.get(), &HTMLNames::titleAttr.get() }) {
+            const auto& value = element->attributeWithoutSynchronization(*attribute);
+            if (!value.isEmpty())
+                return value.string().left(labelLimit);
+        }
+    }
+    if (node.role() != AccessibilityRole::StaticText && node.role() != AccessibilityRole::Heading
+        && !detachedAccessibilityCanPress(node))
+        return { };
+
+    unsigned visited = 0;
+    StringBuilder label;
+    auto collect = [&](auto&& collect, Node& candidate, unsigned depth) -> void {
+        if (++visited > 32 || depth > 6 || label.length() >= labelLimit
+            || candidate.isInUserAgentShadowTree() || candidate.isContentEditable())
+            return;
+        if (RefPtr element = dynamicDowncast<Element>(candidate)) {
+            const auto& name = element->localName();
+            if (element->hasTagName(HTMLNames::inputTag) || element->hasTagName(HTMLNames::textareaTag)
+                || element->hasTagName(HTMLNames::selectTag) || name == "script"_s || name == "style"_s)
+                return;
+        }
+        if (RefPtr value = dynamicDowncast<Text>(candidate)) {
+            label.append(StringView(value->data()).left(labelLimit - label.length()));
+            return;
+        }
+        for (RefPtr child = candidate.firstChild(); child && visited < 32 && label.length() < labelLimit; child = child->nextSibling())
+            collect(collect, *child, depth + 1);
+    };
+    collect(collect, *source, 0);
+    return label.toString();
+}
+
+void WebPage::neAntikDetachedAXSnapshot(CompletionHandler<void(const String&)>&& reply)
+{
+    RefPtr frame = dynamicDowncast<LocalFrame>(corePage()->mainFrame());
+    RefPtr document = frame ? frame->document() : nullptr;
+    RefPtr view = frame ? frame->view() : nullptr;
+    if (!document || !view)
+        return reply({ });
+    std::ignore = AXObjectCache::attemptMainThreadModeTransition();
+    CheckedPtr cache = document->axObjectCache();
+    RefPtr root = cache ? cache->rootObjectForFrame(*frame) : nullptr;
+    if (!root)
+        return reply({ });
+    if (m_neAntikAXDocument.get() != document.get()) {
+        m_neAntikAXDocument = WeakPtr { *document };
+        m_neAntikAXDocumentToken = WTF::UUID::createVersion4().toString();
+    }
+    // Expose only native AX semantics of this document. Never send field
+    // values, selection, DOM source, hrefs, or password-related text.
+    constexpr unsigned nodeLimit = 16;
+    constexpr unsigned depthLimit = 12;
+    unsigned count = 0;
+    unsigned inspected = 0;
+    Ref nodes = JSON::Array::create();
+    auto visit = [&](auto&& visit, AXCoreObject& node, int parent, unsigned depth) -> void {
+        if (++inspected > nodeLimit * 4 || count == nodeLimit || depth == depthLimit || node.isDetached()
+            || node.isAXRemoteFrame() || node.isSecureField() || node.document() != document.get())
+            return;
+        auto index = count++;
+        Ref entry = JSON::Object::create();
+        entry->setString("id"_s, makeString(node.objectID().toUInt64()));
+        entry->setInteger("parent"_s, parent);
+        entry->setString("role"_s, detachedAccessibilityRole(node));
+        entry->setString("label"_s, detachedAccessibilityLabel(node));
+        auto bounds = node.relativeFrame();
+#if ENABLE(ACCESSIBILITY_LOCAL_FRAME)
+        if (depth)
+            bounds = view->contentsToView(bounds);
+#endif
+        if (!std::isfinite(bounds.x()) || !std::isfinite(bounds.y())
+            || !std::isfinite(bounds.width()) || !std::isfinite(bounds.height()))
+            bounds = { };
+        entry->setDouble("x"_s, bounds.x());
+        entry->setDouble("y"_s, bounds.y());
+        entry->setDouble("width"_s, bounds.width());
+        entry->setDouble("height"_s, bounds.height());
+        entry->setBoolean("focusable"_s, node.isEnabled() && node.canSetFocusAttribute());
+        entry->setBoolean("focused"_s, node.isFocused());
+        entry->setBoolean("pressable"_s, detachedAccessibilityCanPress(node));
+        nodes->pushObject(WTF::move(entry));
+        for (auto& child : node.unignoredChildren()) {
+            if (count == nodeLimit || inspected >= nodeLimit * 4)
+                break;
+            visit(visit, child.get(), index, depth + 1);
+        }
+    };
+    visit(visit, *root, -1, 0);
+    Ref snapshot = JSON::Object::create();
+    snapshot->setString("document"_s, m_neAntikAXDocumentToken);
+    snapshot->setArray("nodes"_s, WTF::move(nodes));
+    reply(snapshot->toJSONString());
+}
+
+void WebPage::neAntikDetachedAXAction(const String& token, uint64_t identifier, bool press)
+{
+    RefPtr frame = dynamicDowncast<LocalFrame>(corePage()->mainFrame());
+    RefPtr document = frame ? frame->document() : nullptr;
+    if (!document || document.get() != m_neAntikAXDocument.get() || token.isEmpty() || token != m_neAntikAXDocumentToken
+        || !AXID::isValidIdentifier(identifier))
+        return;
+    CheckedPtr cache = document->axObjectCache();
+    RefPtr node = cache ? cache->objectForID(AXID { identifier }) : nullptr;
+    if (!node || node->isDetached() || !node->isEnabled() || node->isSecureField() || node->document() != document.get())
+        return;
+    if (press && detachedAccessibilityCanPress(*node))
+        node->press();
+    else if (!press && node->canSetFocusAttribute())
+        node->setFocused(true);
+}
+

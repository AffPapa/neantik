+
+- (BOOL)_neAntikRequireRTCProxy:(nw_proxy_config_t)proxy
+{
+    if (!proxy || nw_proxy_config_get_failover_allowed(proxy) || nw_proxy_config_get_type(proxy) != nw_proxy_type_http_connect)
+        return NO;
+    RetainPtr configurations = @[ proxy ];
+    if (!protect(*_websiteDataStore)->setRequiredRTCProxyConfigData(serializedProxyConfigurations(configurations.get())))
+        return NO;
+    _proxyConfigurations = WTF::move(configurations);
+    return YES;
 }
 

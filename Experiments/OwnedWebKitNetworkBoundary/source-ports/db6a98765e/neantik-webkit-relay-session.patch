+bool WebsiteDataStore::setRequiredRTCProxyConfigData(Vector<std::pair<Vector<uint8_t>, std::optional<WTF::UUID>>>&& data)
+{
+    if (m_requiresRTCProxy || networkProcessIfExists() || hasActivePages() || data.size() != 1 || data[0].first.isEmpty())
+        return false;
+
+    // Session creation and process recovery both consume these fields.
+    m_proxyConfigData = WTF::move(data);
+    m_requiresRTCProxy = true;
+    return true;
+}

+nw_proxy_config_t NetworkSessionCocoa::requiredRTCProxyConfig() const
+{
+    ASSERT(isMainRunLoop());
+    if (!m_requiresRTCProxy || m_nwProxyConfigs.size() != 1)
+        return nullptr;
+    auto proxy = m_nwProxyConfigs[0].get();
+    if (!proxy || !isProxyTypeTCPOnly(proxy) || nw_proxy_config_get_failover_allowed(proxy))
+        return nullptr;
+    return proxy;
+}

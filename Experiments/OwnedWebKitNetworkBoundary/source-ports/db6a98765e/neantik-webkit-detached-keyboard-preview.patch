+- (BOOL)_neantikTestKeyDown:(BOOL)down character:(NSString *)character keyCode:(unsigned short)keyCode
+{
+    if (self.window || !_page->hasRunningProcess() || character.length != 1 || keyCode > 127)
+        return NO;
+
+    auto codePoint = [character characterAtIndex:0];
+    if (codePoint < 0x20 || codePoint > 0x7e)
+        return NO;
+
+    RetainPtr event = [NSEvent keyEventWithType:down ? NSEventTypeKeyDown : NSEventTypeKeyUp location:NSZeroPoint modifierFlags:0 timestamp:MonotonicTime::now().secondsSinceEpoch().value() windowNumber:0 context:nil characters:character charactersIgnoringModifiers:character isARepeat:NO keyCode:keyCode];
+    Vector<WebCore::KeypressCommand> commands;
+    if (down) {
+        commands.append(WebCore::KeypressCommand { "insertText:"_s, character });
+        _page->registerKeypressCommandName(commands.first().commandName);
+    }
+    auto input = WebKit::WebEventFactory::createWebKeyboardEvent(event.get(), false, false, commands);
+    _page->handleKeyboardEvent(WebKit::NativeWebKeyboardEvent::create(WTF::move(input)));
+    return YES;
+}
+
 @end
 #endif
 

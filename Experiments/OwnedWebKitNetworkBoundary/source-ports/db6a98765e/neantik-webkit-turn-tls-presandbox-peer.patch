+#if PLATFORM(MAC) && defined(NEANTIK_TURNS_QA_ANCHOR)
+    // Authenticate this launch connection before the network sandbox denies guest lookup.
+    m_hasAuthenticatedNeAntikTURNSQAHost = isSignedNeAntikDevHost(parameters.connectionIdentifier.xpcConnection.get());
+#endif
+
     AuxiliaryProcess::initializeSandbox(parameters, sandboxParameters);
 }
 

+#if PLATFORM(MAC) && defined(NEANTIK_TURNS_QA_ANCHOR)
+static bool isSignedNeAntikDevHost(xpc_connection_t connection)
+{
+    if (!connection)
+        return false;
+    audit_token_t token;
+    xpc_connection_get_audit_token(connection, &token);
+    RetainPtr auditData = adoptCF(CFDataCreate(nullptr, reinterpret_cast<const UInt8*>(&token), sizeof(token)));
+    if (!auditData)
+        return false;
+    const void* keys[] { kSecGuestAttributeAudit };
+    const void* values[] { auditData.get() };
+    RetainPtr attributes = adoptCF(CFDictionaryCreate(nullptr, keys, values, 1, &kCFTypeDictionaryKeyCallBacks, &kCFTypeDictionaryValueCallBacks));
+    SecCodeRef guest = nullptr;
+    if (!attributes)
+        return false;
+    auto guestStatus = SecCodeCopyGuestWithAttributes(nullptr, attributes.get(), kSecCSDefaultFlags, &guest);
+    if (guestStatus != errSecSuccess) {
+        RELEASE_LOG_ERROR(Process, "NeAntik TURNS QA: parent code lookup failed (%d)", guestStatus);
+        return false;
+    }
+    RetainPtr code = adoptCF(guest);
+    SecRequirementRef requirement = nullptr;
+    if (SecRequirementCreateWithString(CFSTR("anchor apple generic and identifier \"app.neantik.desktop.dev.webkit-host\" and certificate leaf[subject.OU] = \"H6VGU2M6JD\" and certificate leaf[field.1.2.840.113635.100.6.1.13] exists"), kSecCSDefaultFlags, &requirement) != errSecSuccess)
+        return false;
+    RetainPtr expected = adoptCF(requirement);
+    auto validationStatus = SecCodeCheckValidity(code.get(), kSecCSDefaultFlags, expected.get());
+    if (validationStatus != errSecSuccess)
+        RELEASE_LOG_ERROR(Process, "NeAntik TURNS QA: parent signature rejected (%d)", validationStatus);
+    return validationStatus == errSecSuccess;
+}
+#endif
+

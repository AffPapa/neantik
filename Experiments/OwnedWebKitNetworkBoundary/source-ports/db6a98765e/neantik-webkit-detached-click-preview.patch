@@ -35,6 +35,9 @@
 
 #import "AppKitSPI.h"
 #import "CompletionHandlerCallChecker.h"
+#if defined(NEANTIK_DETACHED_INPUT_EXPERIMENT)
+#import "NativeWebMouseEvent.h"
+#endif
 #import "PDFPluginIdentifier.h"
 #import "WKAPICast.h"
 #import "WKIntelligenceTextEffectCoordinator.h"
@@ -2309,6 +2312,41 @@ - (void)_storeSimulatedPrivateClickMeasurementConversionWithPriority:(uint8_t)pr
 
 @end // WKWebView (WKPrivateMac)
 
+#if defined(NEANTIK_DETACHED_INPUT_EXPERIMENT)
+@interface WKWebView (NeAntikDetachedInputExperiment)
+- (BOOL)_neantikTestClickAtPosition:(NSPoint)position globalPosition:(NSPoint)globalPosition completion:(void (^)(void))completion;
+@end
+
+@implementation WKWebView (NeAntikDetachedInputExperiment)
+
+- (BOOL)_neantikTestClickAtPosition:(NSPoint)position globalPosition:(NSPoint)globalPosition completion:(void (^)(void))completion
+{
+    if (!completion || self.window || !_page->hasRunningProcess() || !NSPointInRect(position, self.bounds)
+        || !std::isfinite(globalPosition.x) || !std::isfinite(globalPosition.y))
+        return NO;
+
+    for (auto type : { WebKit::WebEventType::MouseDown, WebKit::WebEventType::MouseUp }) {
+        WebKit::WebMouseEventData data;
+        data.button = WebKit::WebMouseEventButton::Left;
+        data.buttons = type == WebKit::WebEventType::MouseDown ? 1 : 0;
+        data.position = { position.x, position.y };
+        data.globalPosition = { globalPosition.x, globalPosition.y };
+        data.clickCount = 1;
+        data.canInitiateDrag = WebCore::PlatformMouseEvent::CanInitiateDrag::No;
+        WebKit::WebMouseEventInit event { { type, { }, MonotonicTime::now() }, WTF::move(data) };
+        _page->handleMouseEvent(WebKit::NativeWebMouseEvent::create(WTF::move(event)));
+    }
+    _page->doAfterProcessingAllPendingMouseEvents([weakSelf = WeakObjCPtr<WKWebView>(self), done = makeBlockPtr(completion)] {
+        RetainPtr view = weakSelf.get();
+        if (view && [view _page]->hasRunningProcess())
+            done();
+    });
+    return YES;
+}
+
+@end
+#endif
+

+
+// NeAntik's fallback must work without sending keystrokes to a provider.
+TEST_F(DefaultSearchManagerTest, NeAntikSubmittedQueryFallback) {
+  auto manager = create_manager();
+  DefaultSearchManager::Source source;
+  const auto* engine = manager->GetDefaultSearchEngine(&source);
+  ASSERT_TRUE(engine);
+  EXPECT_EQ(DefaultSearchManager::FROM_FALLBACK, source);
+  EXPECT_EQ(u"DuckDuckGo", engine->short_name());
+  EXPECT_EQ("https://duckduckgo.com/?q={searchTerms}", engine->url());
+  EXPECT_EQ(1001, engine->prepopulate_id);
+  auto definitions = prepopulate_data_resolver().GetPrepopulatedEngines();
+  size_t matches = 0;
+  for (const auto& definition : definitions) {
+    if (definition->prepopulate_id == engine->prepopulate_id) {
+      ++matches;
+      EXPECT_EQ(engine->url(), definition->url());
+      EXPECT_EQ(engine->sync_guid, definition->sync_guid);
+    }
+  }
+  EXPECT_EQ(1u, matches);
+  auto resolved = prepopulate_data_resolver().GetEngineFromFullList(1001);
+  ASSERT_TRUE(resolved);
+  EXPECT_EQ(engine->url(), resolved->url());
+  EXPECT_TRUE(resolved->suggestions_url.empty());
+  EXPECT_FALSE(engine->safe_for_autoreplace);
+  EXPECT_TRUE(engine->suggestions_url.empty());
+  EXPECT_TRUE(engine->image_url.empty());
+  EXPECT_TRUE(engine->new_tab_url.empty());
+  EXPECT_TRUE(engine->favicon_url.is_empty());
+  EXPECT_FALSE(engine->preconnect_to_search_url);
+  EXPECT_FALSE(engine->prefetch_likely_navigations);
+}
+
+TEST_F(DefaultSearchManagerTest, NeAntikPreservesExplicitSearchChoices) {
+  auto manager = create_manager();
+  auto custom = GenerateDummyTemplateURLData("chosen");
+  manager->SetUserSelectedDefaultSearchEngine(*custom);
+  DefaultSearchManager::Source source;
+  const auto* engine = manager->GetDefaultSearchEngine(&source);
+  ASSERT_TRUE(engine);
+  EXPECT_EQ(DefaultSearchManager::FROM_USER, source);
+  EXPECT_EQ(custom->url(), engine->url());
+
+  // Even an explicit opt-out of search remains the user's choice.
+  auto no_search = prepopulate_data_resolver().GetEngineFromFullList(1);
+  ASSERT_TRUE(no_search);
+  ASSERT_EQ(u"No Search", no_search->short_name());
+  manager->SetUserSelectedDefaultSearchEngine(*no_search);
+  auto reloaded = create_manager();
+  engine = reloaded->GetDefaultSearchEngine(&source);
+  ASSERT_TRUE(engine);
+  EXPECT_EQ(DefaultSearchManager::FROM_USER, source);
+  EXPECT_EQ(u"No Search", engine->short_name());
+  EXPECT_EQ("http://{searchTerms}", engine->url());
+}

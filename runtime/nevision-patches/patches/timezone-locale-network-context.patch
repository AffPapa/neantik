 namespace blink {
 
+std::unique_ptr<TimeZoneController::TimeZoneOverride>&
+NeAntikTimeZoneOverrideHandle() {
+  static base::NoDestructor<
+      std::unique_ptr<TimeZoneController::TimeZoneOverride>>
+      handle;
+  return *handle;
+}
+
+void ApplyNeAntikTimeZoneOverrideFromCommandLine() {
+  const base::CommandLine* command_line =
+      base::CommandLine::ForCurrentProcess();
+  if (!command_line->HasSwitch(switches::kFingerprintTimezone)) {
+    return;
+  }
+
+  std::string timezone_value =
+      command_line->GetSwitchValueASCII(switches::kFingerprintTimezone);
+  String timezone_id = String::FromUtf8(timezone_value);
+  if (timezone_id.empty()) {
+    return;
+  }
+
+  TimeZoneController::TimeZoneOverrideResult result =
+      TimeZoneController::SetTimeZoneOverride(timezone_id);
+  if (result.status ==
+          TimeZoneController::TimeZoneOverrideStatus::kSuccess &&
+      result.handle) {
+    NeAntikTimeZoneOverrideHandle() = std::move(result.handle);
+  }
+}

+// Keep OfflineAudio output stable for a profile without changing the reported
+// sample rate, frame count, or audio graph. The perturbation is deterministic,
+// bounded far below audible amplitude, and applied only to sparse samples
+// after rendering has completed.
+void ApplyNeAntikOfflineAudioFingerprint(AudioBuffer* buffer) {
+  if (!buffer || !ungoogled::nevision::GetProfileSeed()) {
+    return;
+  }
+  constexpr size_t kSampleStride = 128;
+  constexpr float kNoiseStep = 0.0000001f;
+  for (unsigned channel = 0; channel < buffer->numberOfChannels(); ++channel) {
+    auto channel_data = buffer->getChannelData(channel);
+    if (!channel_data) {
+      continue;
+    }
+    auto samples = channel_data->AsSpan();
+    for (size_t index = 0; index < samples.size(); index += kSampleStride) {
+      // Preserve exact digital silence. Adding energy to a silent graph is
+      // observable behavior that no native audio pipeline would produce.
+      if (!std::isfinite(samples[index]) || samples[index] == 0.0f) {
+        continue;
+      }
+      const uint32_t salt_index =
+          static_cast<uint32_t>(index) ^ (channel * 0x9e3779b9u);
+      const int bucket = ungoogled::nevision::GetProfileByte(
+          "offline-audio-sample", salt_index, 9);
+      const float noise = static_cast<float>(bucket - 4) * kNoiseStep;
+      samples[index] = std::clamp(samples[index] + noise, -1.0f, 1.0f);
+    }
+  }

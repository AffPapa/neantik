@@ -0,0 +1,24 @@
+// Copyright 2026 The NeAntik Authors. MPL-2.0.
+#ifndef COMPONENTS_UNGOOGLED_NEANTIK_DEVICE_SCALE_FACTOR_H_
+#define COMPONENTS_UNGOOGLED_NEANTIK_DEVICE_SCALE_FACTOR_H_
+
+#include <cmath>
+
+namespace ungoogled::nevision {
+
+// Native layout ratio already includes hardware DSF, page zoom and frame CSS
+// zoom. Replace only hardware DSF; an explicit DevTools request takes priority.
+inline double AdjustDevicePixelRatio(double native_ratio,
+                                    double native_scale,
+                                    double cohort_scale,
+                                    bool explicit_override) {
+  if (explicit_override || !std::isfinite(native_scale) || native_scale <= 0 ||
+      !std::isfinite(cohort_scale) || cohort_scale <= 0) {
+    return native_ratio;
+  }
+  return native_ratio * (cohort_scale / native_scale);
+}
+
+}  // namespace ungoogled::nevision
+
+#endif  // COMPONENTS_UNGOOGLED_NEANTIK_DEVICE_SCALE_FACTOR_H_

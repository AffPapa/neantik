--- a/third_party/blink/renderer/modules/webgl/webgl_rendering_context_base.cc
+++ b/third_party/blink/renderer/modules/webgl/webgl_rendering_context_base.cc
@@ -27,6 +27,7 @@
 
 #include <inttypes.h>
 
+#include <algorithm>
 #include <memory>
 #include <utility>
 
@@ -45,6 +46,7 @@
 #include "base/trace_event/memory_dump_manager.h"
 #include "base/trace_event/trace_event.h"
 #include "build/build_config.h"
+#include "components/ungoogled/nevision_fingerprint.h"
 #include "components/viz/common/gpu/raster_context_provider.h"
 #include "components/viz/common/resources/shared_image_format_utils.h"
 #include "device/vr/buildflags/buildflags.h"
@@ -5345,6 +5347,30 @@
     }
     ContextGL()->ReadPixels(x, y, width, height, format, type, data);
   }
+
+  if (width > 0 && height > 0 && data && type == GL_UNSIGNED_BYTE &&
+      (format == GL_RGB || format == GL_RGBA) &&
+      ungoogled::nevision::GetProfileSeed().has_value()) {
+    const uint32_t component_count = format == GL_RGBA ? 4 : 3;
+    const size_t available_bytes = buffer_size.ValueOrDie();
+    const size_t pixel_count =
+        std::min<size_t>(static_cast<size_t>(width) * static_cast<size_t>(height),
+                         available_bytes / component_count);
+    const size_t sample_count = std::min<size_t>(pixel_count, 16);
+    for (size_t i = 0; i < sample_count; ++i) {
+      const size_t pixel_index =
+          (pixel_count * (i + 1)) / (sample_count + 1);
+      const size_t byte_index = pixel_index * component_count;
+      const uint8_t delta = ungoogled::nevision::GetProfileByte(
+          "webgl-read-pixels", static_cast<uint32_t>(i), 3);
+      if (delta == 0) {
+        continue;
+      }
+      data[byte_index] = static_cast<uint8_t>(
+          data[byte_index] >= 255 - delta ? data[byte_index] - delta
+                                          : data[byte_index] + delta);
+    }
+  }
 }
 

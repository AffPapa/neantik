+TEST_F(URLRequestTest, BlocksSubstitutedSafeBrowsingUploadHost) {
+  base::test::MockLog log;
+  EXPECT_CALL(log, Log(logging::LOGGING_ERROR, _, _, _,
+                       testing::Not(testing::HasSubstr("private-search-term"))))
+      .Times(2);
+  log.StartCapturingLogs();
+  TestDelegate delegate;
+  const GURL blocked_url(
+      "https://safebrowsing.9oo91e.qjz9zk/safebrowsing/uploads/scan"
+      "?query=private-search-term");
+  std::unique_ptr<URLRequest> request(default_context().CreateRequest(
+      blocked_url, DEFAULT_PRIORITY, &delegate, TRAFFIC_ANNOTATION_FOR_TESTS,
+      net::handles::kInvalidNetworkHandle));
+
+  request->Start();
+  delegate.RunUntilComplete();
+  log.StopCapturingLogs();
+
+  EXPECT_EQ(ERR_BLOCKED_BY_CLIENT, delegate.request_status());
+  EXPECT_TRUE(request->original_url().SchemeIs(url::kTraceScheme));
+}

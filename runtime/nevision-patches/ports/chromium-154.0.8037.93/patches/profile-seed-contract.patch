+#ifndef COMPONENTS_UNGOOGLED_NEANTIK_FINGERPRINT_H_
+#define COMPONENTS_UNGOOGLED_NEANTIK_FINGERPRINT_H_
+
+#include <stdint.h>
+
+#include <optional>
+#include <string_view>
+
+#include "base/component_export.h"
+
+namespace ungoogled::nevision {
+
+// Returns the validated NeAntik profile seed from the current process command
+// line. The value is intentionally constrained to a signed 31-bit range to
+// match the native NeAntik launch contract. Missing, zero, or malformed
+// values return std::nullopt so callers preserve stock Chromium behavior.
+COMPONENT_EXPORT(UNGOOGLED) std::optional<uint32_t> GetProfileSeed();
+
+// Returns a deterministic unit interval value derived from the profile seed and
+// a call-site salt. Missing or malformed profile seed returns std::nullopt.
+COMPONENT_EXPORT(UNGOOGLED)
+std::optional<double> GetProfileUnitInterval(std::string_view salt);
+
+// Returns a deterministic byte in [0, exclusive_max) derived from the profile
+// seed, call-site salt, and index. Missing or malformed profile seed returns
+// zero so callers can fail closed without adding random noise.
+COMPONENT_EXPORT(UNGOOGLED)
+uint8_t GetProfileByte(std::string_view salt,
+                       uint32_t index,
+                       uint8_t exclusive_max);
+
+}  // namespace ungoogled::nevision
+
+#endif  // COMPONENTS_UNGOOGLED_NEANTIK_FINGERPRINT_H_

   base::LaunchOptions options;
   options.new_process_group = true;
 
+  // The font witness is process-scoped to browser/renderers. This helper has
+  // no profile and must not inherit QA guards, seeds or developer credentials.
+  auto environment = base::Environment::Create();
+  if (environment->GetVar("NEANTIK_FONT_QA") == "owned-v1") {
+    options.clear_environment = true;
+    constexpr const char* keys[] = {"HOME", "LANG", "LC_ALL", "LC_CTYPE",
+        "LOGNAME", "PATH", "SHELL", "TMPDIR", "USER", "XPC_FLAGS",
+        "XPC_SERVICE_NAME", "__CFBundleIdentifier", "BREAKPAD_DUMP_LOCATION"};
+    for (const char* key : keys) {
+      if (auto value = environment->GetVar(key))
+        options.environment[key] = *value;
+    }
+  }
+

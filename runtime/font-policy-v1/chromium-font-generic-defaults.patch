+#if BUILDFLAG(IS_MAC)
+#include "components/ungoogled/system_font_policy_mac.h"
+#endif
 
 namespace blink {
+
+// Shared/service workers have no document from which to inherit generic maps.
+// Only the explicit, seeded development policy supplies Chrome macOS defaults.
+// Existing COMMON/per-script mappings and downloaded font resources survive.
+void ApplySystemFontPolicyGenericDefaultsIfEmpty(
+    GenericFontFamilySettings& settings) {
+#if BUILDFLAG(IS_MAC)
+  if (!ungoogled::nevision::SystemFontPolicyV1Enabled())
+    return;
+  if (settings.Standard().empty())
+    settings.UpdateStandard(AtomicString("Times"));
+  if (settings.Fixed().empty())
+    settings.UpdateFixed(AtomicString("Menlo"));
+  if (settings.Serif().empty())
+    settings.UpdateSerif(AtomicString("Times"));
+  if (settings.SansSerif().empty())
+    settings.UpdateSansSerif(AtomicString("Helvetica"));
+  if (settings.Cursive().empty())
+    settings.UpdateCursive(AtomicString("Apple Chancery"));
+  if (settings.Fantasy().empty())
+    settings.UpdateFantasy(AtomicString("Papyrus"));
+  if (settings.Math().empty())
+    settings.UpdateMath(AtomicString("STIX Two Math"));
+#endif
+}

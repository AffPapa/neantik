+// Validate variation coordinates against the independently loaded file face.
+// Metadata from the submitted font cannot authorize an unsupported axis.
+bool VariationValue(CFTypeRef value, double* result) {
+  return value && CFGetTypeID(value) == CFNumberGetTypeID() &&
+      CFNumberGetValue(static_cast<CFNumberRef>(value), kCFNumberDoubleType, result) &&
+      std::isfinite(*result);
+}
+
+bool SupportedVariation(CFDictionaryRef variation, CFArrayRef axes) {
+  if (!variation || CFGetTypeID(variation) != CFDictionaryGetTypeID() ||
+      CFDictionaryGetCount(variation) > 64 || !axes || CFArrayGetCount(axes) > 64) return false;
+  const CFIndex count = CFDictionaryGetCount(variation);
+  std::vector<const void*> keys(count), values(count);
+  CFDictionaryGetKeysAndValues(variation, keys.data(), values.data());
+  for (CFIndex i = 0; i < count; ++i) {
+    double value = 0;
+    if (!keys[i] || CFGetTypeID(keys[i]) != CFNumberGetTypeID() ||
+        !VariationValue(values[i], &value)) return false;
+    bool supported = false;
+    for (CFIndex j = 0; j < CFArrayGetCount(axes); ++j) {
+      auto axis = static_cast<CFDictionaryRef>(CFArrayGetValueAtIndex(axes, j));
+      if (!axis || CFGetTypeID(axis) != CFDictionaryGetTypeID()) return false;
+      auto tag = CFDictionaryGetValue(axis, kCTFontVariationAxisIdentifierKey);
+      double minimum = 0, maximum = 0, fallback = 0;
+      if (!tag || CFGetTypeID(tag) != CFNumberGetTypeID() ||
+          !VariationValue(CFDictionaryGetValue(axis, kCTFontVariationAxisMinimumValueKey), &minimum) ||
+          !VariationValue(CFDictionaryGetValue(axis, kCTFontVariationAxisMaximumValueKey), &maximum) ||
+          !VariationValue(CFDictionaryGetValue(axis, kCTFontVariationAxisDefaultValueKey), &fallback) ||
+          minimum > fallback || fallback > maximum) return false;
+      if (CFEqual(keys[i], tag)) { supported = minimum <= value && value <= maximum; break; }
+    }
+    if (!supported) return false;
+  }
+  return true;
+}
+
+bool SameEffectiveVariation(CFDictionaryRef requested, CTFontRef counterpart, CFArrayRef axes) {
+  OwnedCF<CFDictionaryRef> applied(CTFontCopyVariation(counterpart));
+  if (applied.get() && !SupportedVariation(applied.get(), axes)) return false;
+  for (CFIndex i = 0; i < CFArrayGetCount(axes); ++i) {
+    auto axis = static_cast<CFDictionaryRef>(CFArrayGetValueAtIndex(axes, i));
+    auto tag = CFDictionaryGetValue(axis, kCTFontVariationAxisIdentifierKey);
+    double fallback = 0;
+    if (!VariationValue(CFDictionaryGetValue(axis, kCTFontVariationAxisDefaultValueKey), &fallback)) return false;
+    double a = fallback, b = fallback;
+    auto x = CFDictionaryGetValue(requested, tag);
+    auto y = applied.get() ? CFDictionaryGetValue(applied.get(), tag) : nullptr;
+    if ((x && !VariationValue(x, &a)) || (y && !VariationValue(y, &b))) return false;
+    // A font's fixed-point design coordinate has 16 fractional bits. Never
+    // accept a different effective instance merely because its name matches.
+    if (std::abs(a - b) > 1.0 / 65536.0) return false;
   }
   return true;
 }

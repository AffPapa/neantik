+        (chosen && BetterChoice(desired_traits,weight,chosen_traits,chosen_weight,traits,candidate_weight))) {
+      chosen=std::move(font);chosen_weight=candidate_weight;chosen_traits=traits;
+      if (chosen_weight==weight && (chosen_traits & IMPORTANT_FONT_TRAITS)==(desired_traits & IMPORTANT_FONT_TRAITS)) break;
+    }
+  }
+  return chosen;

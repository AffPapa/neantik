+ScopedCFTypeRef<CTFontRef> MatchProtectedNSFamily(CFStringRef requested,
+    NSFontTraitMask desired_traits, FontSelectionValue desired_weight, float size) {
+  ScopedCFTypeRef<CFStringRef> family(static_cast<CFStringRef>(CFRetain(requested)));
+  NSFontManager* manager = NSFontManager.sharedFontManager;
+  const NSInteger weight = ToAppKitFontWeight(desired_weight);
+  auto choices = [&](CFStringRef name) {
+    return ScopedCFTypeRef<CFArrayRef>(ungoogled::nevision::CopyProtectedFontCandidates(name));
+  };
+  auto candidates = choices(family.get());
+  auto same_family = [&](CTFontRef font) {
+    ScopedCFTypeRef<CFStringRef> actual(CTFontCopyFamilyName(font));
+    return actual && CFStringCompare(actual.get(),family.get(),kCFCompareCaseInsensitive)==kCFCompareEqualTo;
+  };
+  bool family_exists=false;
+  for (CFIndex i=0;i<CFArrayGetCount(candidates.get());++i) {
+    auto descriptor=CFCast<CTFontDescriptorRef>(CFArrayGetValueAtIndex(candidates.get(),i));
+    ScopedCFTypeRef<CTFontRef> font(descriptor?CTFontCreateWithFontDescriptor(descriptor,size,nullptr):nullptr);
+    family_exists |= font && same_family(font.get()) && ungoogled::nevision::IsAllowedSystemHostFont(font.get());
+  }
+  if (!family_exists) {
+    auto named=MatchProtectedUniqueFont(requested,size);
+    if (!named) return ScopedCFTypeRef<CTFontRef>();
+    ScopedCFTypeRef<CFStringRef> postscript(CTFontCopyPostScriptName(named.get()));
+    if (!postscript || CFStringCompare(postscript.get(),requested,kCFCompareCaseInsensitive)!=kCFCompareEqualTo) return ScopedCFTypeRef<CTFontRef>();
+    family.reset(CTFontCopyFamilyName(named.get()));
+    if (!family) return ScopedCFTypeRef<CTFontRef>();
+    NSFontTraitMask named_traits=[manager traitsOfFont:(__bridge NSFont*)named.get()];
+    NSFontTraitMask required=desired_traits | (weight>=7?NSBoldFontMask:0);
+    if ((CFStringCompare(family.get(),CFSTR("Osaka-Mono"),kCFCompareCaseInsensitive)==kCFCompareEqualTo && !required) ||
+        (named_traits & required)==required) return named;
+    candidates=choices(family.get());
+  }
+  ScopedCFTypeRef<CTFontRef> chosen;
+  NSInteger chosen_weight=0;
+  NSFontTraitMask chosen_traits=0;
+  for (CFIndex i=0;i<CFArrayGetCount(candidates.get());++i) {
+    auto descriptor=CFCast<CTFontDescriptorRef>(CFArrayGetValueAtIndex(candidates.get(),i));
+    ScopedCFTypeRef<CTFontRef> font(descriptor?CTFontCreateWithFontDescriptor(descriptor,size,nullptr):nullptr);
+    if (!font || !same_family(font.get()) || !ungoogled::nevision::IsAllowedSystemHostFont(font.get())) continue;
+    NSFont* native=(__bridge NSFont*)font.get();
+    const NSFontTraitMask traits=[manager traitsOfFont:native];
+    const NSInteger candidate_weight=[manager weightOfFont:native];

+// Direct protected descriptors avoid a global PostScript/full-name relookup.
+ScopedCFTypeRef<CTFontRef> MatchProtectedUniqueFont(CFStringRef name, float size) {
+  ScopedCFTypeRef<CFArrayRef> candidates(
+      ungoogled::nevision::CopyProtectedFontDescriptors());
+  for (CFIndex i = 0; i < CFArrayGetCount(candidates.get()); ++i) {
+    auto descriptor = CFCast<CTFontDescriptorRef>(CFArrayGetValueAtIndex(candidates.get(), i));
+    if (!descriptor) continue;
+    ScopedCFTypeRef<CTFontRef> font(CTFontCreateWithFontDescriptor(descriptor, size, nullptr));
+    if (!font) continue;
+    ScopedCFTypeRef<CFStringRef> postscript(CTFontCopyPostScriptName(font.get()));
+    ScopedCFTypeRef<CFStringRef> full_name(CTFontCopyFullName(font.get()));
+    if ((postscript && CFStringCompare(postscript.get(), name, kCFCompareCaseInsensitive) == kCFCompareEqualTo) ||
+        (full_name && CFStringCompare(full_name.get(), name, kCFCompareCaseInsensitive) == kCFCompareEqualTo)) {
+      if (ungoogled::nevision::IsAllowedSystemHostFont(font.get())) return font;
+    }
+  }
+  return ScopedCFTypeRef<CTFontRef>();
+}

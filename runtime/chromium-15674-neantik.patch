+// Generated by apply-owned-runtime-device-tuples.py.
+// Source: runtime/apple-device-tuples.json. Do not edit by hand.
+#ifndef COMPONENTS_UNGOOGLED_NEANTIK_APPLE_DEVICE_TUPLES_H_
+#define COMPONENTS_UNGOOGLED_NEANTIK_APPLE_DEVICE_TUPLES_H_
+
+#include <cstddef>
+#include <cstdint>
+
+namespace ungoogled::nevision {
+
+struct AppleDeviceTuple {
+  const char* id;
+  const char* gpu_model;
+  unsigned hardware_concurrency;
+  unsigned physical_memory_gb;
+  unsigned web_device_memory_gb;
+  int screen_width;
+  int screen_height;
+  int available_width;
+  int available_height;
+  unsigned color_depth;
+  double device_scale_factor;
+  const char* platform_version;
+};
+
+inline constexpr AppleDeviceTuple kAppleDeviceTuples[] = {
+    {"macbook-air-m1", "M1", 8, 8, 8, 1280, 800, 1280, 775, 24, 2, "15.5.0"},
+    {"macbook-pro-m1-pro", "M1 Pro", 10, 16, 8, 1512, 982, 1512, 957, 24, 2, "15.4.1"},
+    {"macbook-air-m2", "M2", 8, 8, 8, 1280, 832, 1280, 807, 24, 2, "15.4.0"},
+    {"macbook-pro-m2-max", "M2 Max", 12, 32, 8, 1728, 1117, 1728, 1092, 24, 2, "15.3.2"},
+    {"macbook-pro-m2-pro", "M2 Pro", 12, 16, 8, 1512, 982, 1512, 957, 24, 2, "15.3.1"},
+    {"macbook-air-m3", "M3", 8, 8, 8, 1280, 832, 1280, 807, 24, 2, "15.3.0"},
+    {"macbook-pro-m3-max", "M3 Max", 16, 36, 8, 1728, 1117, 1728, 1092, 24, 2, "15.2.0"},
+    {"macbook-pro-m3-pro", "M3 Pro", 12, 18, 8, 1512, 982, 1512, 957, 24, 2, "15.1.1"},
+    {"macbook-air-m4", "M4", 10, 16, 8, 1280, 832, 1280, 807, 24, 2, "15.1.0"},
+    {"macbook-pro-m4-max", "M4 Max", 16, 36, 8, 1728, 1117, 1728, 1092, 24, 2, "15.0.1"},
+    {"macbook-pro-m4-pro", "M4 Pro", 14, 24, 8, 1512, 982, 1512, 957, 24, 2, "15.5.0"},
+};
+
+inline constexpr size_t kAppleDeviceTupleCount =
+    sizeof(kAppleDeviceTuples) / sizeof(kAppleDeviceTuples[0]);
+
+inline const AppleDeviceTuple& GetAppleDeviceTuple(uint32_t seed) {
+  return kAppleDeviceTuples[seed % kAppleDeviceTupleCount];
+}
+
+}  // namespace ungoogled::nevision
+
+#endif  // COMPONENTS_UNGOOGLED_NEANTIK_APPLE_DEVICE_TUPLES_H_
diff --git a/components/ungoogled/nevision_fingerprint.cc b/components/ungoogled/nevision_fingerprint.cc
new file mode 100644
index 0000000000..60b5ea3d6b
--- /dev/null
+++ b/components/ungoogled/nevision_fingerprint.cc
@@ -0,0 +1,83 @@
+// Copyright (c) 2026 NeAntik Authors. All rights reserved.
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "components/ungoogled/nevision_fingerprint.h"
+
+#include <limits>
+#include <optional>
+#include <string>
+#include <string_view>
+
+#include "base/environment.h"
+#include "base/hash/hash.h"
+#include "base/strings/string_number_conversions.h"
+
+namespace ungoogled::nevision {
+
+namespace {
+
+constexpr uint32_t kMaximumRuntimeSeed =
+    static_cast<uint32_t>(std::numeric_limits<int32_t>::max());
+
+std::optional<uint32_t> ReadSeedFromEnvironment() {
+  std::optional<std::string> value =
+      base::Environment::Create()->GetVar("NEANTIK_PROFILE_SEED");
+  if (!value) {
+    return std::nullopt;
+  }
+
+  uint32_t seed = 0;
+  if (!base::StringToUint(*value, &seed)) {
+    return std::nullopt;
+  }
+  if (seed == 0 || seed > kMaximumRuntimeSeed) {
+    return std::nullopt;
+  }
+  return seed;
+}
+
+const std::optional<uint32_t>& CachedProfileSeed() {
+  // The manager fixes the child environment before Process.run(). Reading it
+  // once avoids an environment lookup for every deterministic audio sample or
+  // pixel while keeping one stable value for the lifetime of this process.
+  static const std::optional<uint32_t> seed = ReadSeedFromEnvironment();
+  return seed;
+}
+
+uint32_t SaltedProfileHash(uint32_t seed, std::string_view salt) {
+  return base::PersistentHash(base::NumberToString(seed) + ":" +
+                              std::string(salt));
+}
+
+}  // namespace
+
+std::optional<uint32_t> GetProfileSeed() {
+  return CachedProfileSeed();
+}
+
+std::optional<double> GetProfileUnitInterval(std::string_view salt) {
+  std::optional<uint32_t> seed = GetProfileSeed();
+  if (!seed) {
+    return std::nullopt;
+  }
+  return static_cast<double>(SaltedProfileHash(*seed, salt)) /
+         static_cast<double>(std::numeric_limits<uint32_t>::max());
+}
+
+uint8_t GetProfileByte(std::string_view salt,
+                       uint32_t index,
+                       uint8_t exclusive_max) {
+  if (exclusive_max == 0) {
+    return 0;
+  }
+  std::optional<uint32_t> seed = GetProfileSeed();
+  if (!seed) {
+    return 0;
+  }
+  uint32_t hash = SaltedProfileHash(
+      *seed, std::string(salt) + ":" + base::NumberToString(index));
+  return static_cast<uint8_t>(hash % exclusive_max);
+}
+
+}  // namespace ungoogled::nevision

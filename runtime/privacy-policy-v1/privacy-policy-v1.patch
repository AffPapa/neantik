+
+bool NeAntikProtectionReady(content::BrowserContext* context) {
+  auto environment = base::Environment::Create();
+  const auto id = environment->GetVar("NEANTIK_PROFILE_PRIVACY_EXTENSION_ID");
+  if (!id) {
+    return true;
+  }
+  unsigned baseline_count = 0;
+  const auto count = environment->GetVar("NEANTIK_PROFILE_PRIVACY_BASELINE_RULES");
+  if (!context || context->IsOffTheRecord() || id->size() != 32 ||
+      id->find_first_not_of("abcdefghijklmnop") != std::string::npos || !count ||
+      !base::StringToUint(*count, &baseline_count) || baseline_count == 0 ||
+      baseline_count > 600) {
+    return false;
+  }
+  auto* registry = extensions::ExtensionRegistry::Get(context);
+  const auto* extension = registry ? registry->enabled_extensions().GetByID(*id) : nullptr;
+  if (!extension) {
+    return false;
+  }
+  namespace dnr = extensions::declarative_net_request;
+  auto* service = dnr::RulesMonitorService::Get(context);
+  auto* matcher = service ? service->ruleset_manager()->GetMatcherForExtension(*id) : nullptr;
+  if (!matcher) {
+    return false;
+  }
+  const auto& declared =
+      dnr::DNRManifestData::GetManifestIDToRulesetMap(*extension);
+  auto has_static = [&](const char* name, size_t expected_count) {
+    auto item = declared.find(name);
+    return item != declared.end() && matcher->GetMatcherWithID(item->second->id) &&
+           service->GetRuleCounts(*id, item->second->id).rule_count == expected_count;
+  };
+  // Dynamic rules are reserved exclusively for complete validated threat-list
+  // replacements (minimum1000domains/500-domain chunks), never tracker allows.
+  const bool dynamic_threats = matcher->GetMatcherWithID(dnr::kDynamicRulesetID) &&
+      service->GetRuleCounts(*id, dnr::kDynamicRulesetID).rule_count >= 2;
+  if (!has_static("cert_baseline", baseline_count) && !dynamic_threats) {
+    return false;
+  }
+  if (!has_static("trackers", 1)) {
+    return false;
+  }
+  const auto cleanup = environment->GetVar("NEANTIK_PROFILE_QUERY_CLEANUP");
+  return !cleanup || *cleanup != "1" || has_static("query_cleanup", 1);
+}

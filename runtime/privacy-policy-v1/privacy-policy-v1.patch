 using ProviderType = content_settings::ProviderType;
 
+// Effective profile policy only: never overwrite saved user grants or defaults.
+// No environment value preserves ordinary Chromium behavior.
+std::optional<PermissionSetting> NeAntikProfilePermissionOverride(
+    ContentSettingsType type) {
+  if (!PermissionSettingsRegistry::GetInstance()->Get(type)) {
+    return std::nullopt;
+  }
+  auto environment = base::Environment::Create();
+  const auto lan = environment->GetVar("NEANTIK_PROFILE_LAN");
+  if (lan && *lan == "deny" &&
+      (type == ContentSettingsType::LOCAL_NETWORK_ACCESS ||
+       type == ContentSettingsType::LOCAL_NETWORK ||
+       type == ContentSettingsType::LOOPBACK_NETWORK)) {
+    return CONTENT_SETTING_BLOCK;
+  }
+  const auto media = environment->GetVar("NEANTIK_PROFILE_MEDIA");
+  if (media && *media == "deny") {
+    switch (type) {
+      case ContentSettingsType::MEDIASTREAM_MIC:
+      case ContentSettingsType::MEDIASTREAM_CAMERA:
+      case ContentSettingsType::GEOLOCATION:
+      case ContentSettingsType::NOTIFICATIONS:
+        return CONTENT_SETTING_BLOCK;
+      case ContentSettingsType::GEOLOCATION_WITH_OPTIONS:
+        return GeolocationSetting(PermissionOption::kDenied,
+                                  PermissionOption::kDenied);
+      default:
+        break;
+    }
+  }
+  return std::nullopt;
+}

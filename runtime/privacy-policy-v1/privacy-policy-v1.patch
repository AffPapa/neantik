+// Native pre-network gate. Extension enabled/ready alone does not establish
+// DNR indexing completion. This finite wait never blocks the UI/file sequence.
+class NeAntikProtectionThrottle final : public blink::URLLoaderThrottle {
+ public:
+  explicit NeAntikProtectionThrottle(content::BrowserContext* context)
+      : context_(context->GetWeakPtr()) {}
+
+  void WillStartRequest(network::ResourceRequest* request, bool* defer) override {
+    Check(request->url, defer);
+  }
+  void WillRedirectRequest(
+      net::RedirectInfo* redirect_info,
+      const network::mojom::URLResponseHead& response_head,
+      bool* defer,
+      network::HttpRequestHeadersUpdateParams* headers_update_params) override {
+    Check(redirect_info->new_url, defer);
+  }
+
+ private:
+  void Check(const GURL& url, bool* defer) {
+    if (!url.SchemeIsHTTPOrHTTPS() || NeAntikProtectionReady(context_.get())) {
+      return;
+    }
+    *defer = true;
+    deadline_ = base::TimeTicks::Now() + base::Seconds(5);
+    timer_.Start(FROM_HERE, base::Milliseconds(20),
+                 base::BindRepeating(&NeAntikProtectionThrottle::Poll,
+                                     weak_factory_.GetWeakPtr()));
+  }
+  void Poll() {
+    if (context_ && NeAntikProtectionReady(context_.get())) {
+      timer_.Stop();
+      delegate_->Resume();
+      return;
+    }
+    if (!context_ || base::TimeTicks::Now() >= deadline_) {
+      timer_.Stop();
+      delegate_->CancelWithError(net::ERR_BLOCKED_BY_CLIENT,
+                                "NeAntik protection is not ready");
+    }
+  }
+  base::WeakPtr<content::BrowserContext> context_;
+  base::TimeTicks deadline_;
+  base::RepeatingTimer timer_;
+  base::WeakPtrFactory<NeAntikProtectionThrottle> weak_factory_{this};
+};

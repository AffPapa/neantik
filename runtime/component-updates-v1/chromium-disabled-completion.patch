+// NeAntik keeps component requests disabled, but every call must finish.
+// RunUntilIdle makes the old silent return fail without an unbounded RunLoop.
+TEST_P(UpdateCheckerTest, NeAntikDisabledChecksCompleteAsynchronously) {
+  update_checker_ = UpdateChecker::Create(config_);
+  int callbacks = 0;
+  for (int attempt = 0; attempt < 3; ++attempt) {
+    update_checker_->CheckForUpdates(
+        update_context_, {},
+        base::BindLambdaForTesting(
+            [&](std::optional<ProtocolParser::Results> results,
+                ErrorCategory category, int error, int retry_after_sec) {
+              ++callbacks;
+              EXPECT_FALSE(results.has_value());
+              EXPECT_EQ(ErrorCategory::kUpdateCheck, category);
+              EXPECT_EQ(static_cast<int>(ProtocolError::UNSUPPORTED_OPERATION), error);
+              EXPECT_EQ(0, retry_after_sec);
+            }));
+    EXPECT_EQ(attempt, callbacks);
+    base::RunLoop().RunUntilIdle();
+    EXPECT_EQ(attempt + 1, callbacks);
+    EXPECT_EQ(0, post_interceptor_->GetCount());
+    EXPECT_EQ(static_cast<int>(ErrorCategory::kUpdateCheck),
+              pref_->GetInteger(kLastUpdateCheckErrorCategoryPreference));
